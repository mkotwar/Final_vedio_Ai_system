# Required for a new pipeline run: absolute path to a local input video.
TD_CASE2_INPUT_VIDEO=

# Optional output location and sampling interval.
TD_CASE2_OUTPUT_ROOT=debug_runs
TD_CASE2_SAMPLE_EVERY_SECONDS=1.0
TD_CASE2_DEVICE=auto
# Optional: select a non-default CUDA device index when more than one GPU exists.
TD_CASE2_DEVICE_INDEX=0

# Use the combined YOLO model checked into this repository.
# Run commands from the repository root so this relative path resolves correctly.
TD_CASE2_YOLO_MODEL_PATH=../../yolo11m.pt
# Optional per-stage override. Leave unset to inherit TD_CASE2_DEVICE.
# TD_CASE2_YOLO_DEVICE=cpu

# Required for the full search-ready pipeline (Step 04A/Step 06).
# Point this at a local Florence-2 model directory.
TD_CASE2_FLORENCE_MODEL_PATH=
TD_CASE2_FLORENCE_ADAPTER_PATH=
TD_CASE2_PLATE_DETECTOR_MODEL_PATH=../../OCR_MUKUL/license_plate_weights.pt
# Optional per-stage overrides. Leave unset for automatic GPU-first behavior.
# TD_CASE2_FLORENCE_DEVICE=cpu
# TD_CASE2_STEP06_DEVICE=cpu

# Existing run folder used by the UI and later-stage runners.
TD_CASE2_RUN_DIR=

# Credential-free local development default. Alternatives: local_qwen, api_qwen.
TD_CASE2_VLM_BACKEND=local_qwen

# Required only when TD_CASE2_VLM_BACKEND=local_qwen.
TD_CASE2_STEP11_5_MODEL_PATH=
TD_CASE2_STEP14_MODEL_PATH=
# Optional per-stage overrides. Leave unset for automatic GPU-first behavior.
# TD_CASE2_STEP11_5_DEVICE=cpu
# TD_CASE2_STEP14_DEVICE=cpu

# Required only when TD_CASE2_VLM_BACKEND=api_qwen.
TD_CASE2_QWEN_API_PROVIDER=openrouter
TD_CASE2_QWEN_API_KEY=
TD_CASE2_QWEN_API_MODEL=qwen/qwen3-vl-8b-instruct
